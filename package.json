{
  "name": "github-readme-viewer",
  "displayName": "github-readme-viewer",
  "description": "View README.md files like on GitHub with dark/light mode toggle.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "github-readme-viewer.openReadme",
        "title": "Open README Preview",
        "icon": "$(preview)",
        "category": "GitHub README Viewer"
      },
      {
        "command": "github-readme-viewer.toggleTheme",
        "title": "Toggle Preview Theme",
        "icon": "$(color-mode)",
        "category": "GitHub README Viewer"
      }
    ],
    "keybindings": [
      {
        "command": "github-readme-viewer.openReadme",
        "key": "alt+r",
        "mac": "opt+r",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "github-readme-viewer.toggleTheme",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeWebviewPanelId == 'githubReadmePreview'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "github-readme-viewer.openReadme",
          "when": "editorLangId == markdown && !isInDiffEditor",
          "group": "navigation"
        }
      ],
      "webview/title": [
        {
          "command": "github-readme-viewer.toggleTheme",
          "when": "webviewId == githubReadmePreview",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "GitHub README Viewer",
      "properties": {
        "github-readme-viewer.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open preview when a markdown file is opened"
        },
        "github-readme-viewer.updateDelay": {
          "type": "number",
          "default": 300,
          "description": "Delay in milliseconds before updating preview after editing (0 = instant update)",
          "minimum": 0,
          "maximum": 2000
        },
        "github-readme-viewer.supportedFiles": {
          "type": "array",
          "default": ["*.md"],
          "description": "File patterns to support (e.g., ['*.md', 'README*', '*.markdown'])",
          "items": {
            "type": "string"
          }
        },
        "github-readme-viewer.protectPreviewColumn": {
          "type": "boolean",
          "default": false,
          "description": "Protect the preview column from other files. When enabled, the preview uses a dedicated column and other files opened in that column will be moved to the first column."
        },
        "github-readme-viewer.openInBrowser": {
          "type": "boolean",
          "default": false,
          "description": "Open preview in external browser instead of VS Code webview panel. The preview will update automatically as you edit the file."
        },
        "github-readme-viewer.browserPort": {
          "type": "number",
          "default": 8080,
          "description": "Port number for the local HTTP server when opening preview in browser",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    }
  },
  "scripts": {
    "test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/extensionTests.js",
    "pretest": "npm run compile-web",
    "vscode:prepublish": "npm run package-web",
    "compile-web": "npm run check-types && npm run lint && node esbuild.js",
    "watch-web": "npm-run-all -p watch-web:*",
    "watch-web:esbuild": "node esbuild.js --watch",
    "watch-web:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package-web": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@types/assert": "^1.5.11",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-web": "^0.0.74",
    "assert": "^2.1.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "glob": "^11.0.3",
    "mocha": "^11.7.4",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/markdown-it": "^14.1.2",
    "github-markdown-css": "^5.8.1",
    "markdown-it": "^14.1.0"
  }
}
